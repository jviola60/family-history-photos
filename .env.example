# Copy this file to ".env" and fill in the value. ".env" is ignored by Git.
# FamilySearch AppKey (the "client_id") from developers.familysearch.org
VITE_FS_CLIENT_ID=

# Beta (integration) environment while testing
VITE_FS_AUTH_URL=https://identbeta.familysearch.org/cis-web/oauth2/v3/authorization
VITE_FS_TOKEN_URL=https://identbeta.familysearch.org/cis-web/oauth2/v3/token
VITE_FS_API_BASE=https://apibeta.familysearch.org
