# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files (API keys) - never commit these
.env
.env.*
!.env.example

# Large AI model binaries (>100MB exceeds GitHub push limit)
*.onnx
ai_service/models/*.onnx
__pycache__/
*.pyc
*test_*_out.jpg

# Personal photos must never be committed next to the local AI service.
# Synthetic fixtures live in ai_service/test_fixtures/ (not matched by these
# one-level patterns) and are the only images that belong in git.
ai_service/*.jpg
ai_service/*.jpeg
ai_service/*.png
ai_service/*.heic
ai_service/*.heif
ai_service/*.gif
ai_service/*.webp
ai_service/*.bmp
ai_service/*.tif
ai_service/*.tiff

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace
